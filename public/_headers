/*
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: no-referrer
  Permissions-Policy: camera=(), microphone=(), geolocation=()
  Cache-Control: no-cache

# Hashed build assets are immutable — cache them hard. Everything else
# (index.html and its SPA-fallback copies at /debts etc.) must revalidate on
# every load, or a tab refreshed after a deploy keeps pointing at chunk
# filenames that no longer exist and the page renders blank.
/assets/*
  ! Cache-Control
  Cache-Control: public, max-age=31536000, immutable

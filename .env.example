# --- Client (safe to expose — protected by Supabase RLS) ---
# Supabase project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=
# Supabase publishable (anon) key — NOT the service role key
VITE_SUPABASE_ANON_KEY=

# --- Server-side only (Supabase Edge Function secrets — NEVER put these in the client) ---
# Set with: supabase secrets set ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_API_KEY=

# Notes:
# - The Anthropic API key lives ONLY in Supabase Edge Function secrets.
# - No secret keys are ever bundled into the browser build.
